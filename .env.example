# Configuration PortalJob Scraper
# Copie ce fichier vers config/.env et remplace les valeurs

# ================================
# TELEGRAM BOT
# ================================
TELEGRAM_TOKEN=votre_token_bot_ici
TELEGRAM_CHAT_ID=votre_chat_id_ici

# ================================
# HUGGING FACE API (Lettres de Motivation)
# ================================
# Obtenez votre clé gratuite sur: https://huggingface.co/settings/tokens
HF_API_KEY=votre_cle_hf_ici

# ================================
# MODE DÉPLOIEMENT (optionnel)
# ================================
# Définit true pour exécution sur serveur cloud (GitHub Actions, etc)
# Sans interface graphique, plus rapide
HEADLESS=false

# ================================
# TURSO (SQLite cloud) - OPTIONNEL
# ================================
# Si configuré, remplace SQLite local
# Crée une base gratuite sur: https://turso.tech
TURSO_DATABASE_URL=libsql://votre-base-USERNAME.turso.io
TURSO_AUTH_TOKEN=votre_token_turso

# Exemple de valeurs:
# TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz
# TELEGRAM_CHAT_ID=123456789
# HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HEADLESS=true  # Pour déploiement cloud
# TURSO_DATABASE_URL=libsql://portaljob-tonuser.turso.io
# TURSO_AUTH_TOKEN=eyJhbGc...
